generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  prospect
  customer
  partner
  inactive
}

enum LeadStatus {
  new
  qualified
  disqualified
  converted
}

enum OpportunityStage {
  qualification
  discovery
  proposal
  negotiation
  closed_won
  closed_lost
}

enum TaskStatus {
  open
  in_progress
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
}

enum UserStatus {
  invited
  active
  suspended
}

enum OutboxStatus {
  pending
  delivering
  delivered
  failed
}

enum AttendeeAccessStatus {
  unknown
  unavailable
  registered_only
  sponsor_directory
  opt_in_directory
  lead_retrieval
  post_event_opt_in
}

enum ConferenceRole {
  speaker
  moderator
  sponsor
  exhibitor
  startup_showcase
  award_finalist
  side_event_host
  attendee
  organizer
  partner
  other
}

enum ConferenceSourceType {
  official_directory
  sponsor_access
  speaker_agenda
  sponsor_exhibitor_list
  startup_showcase
  linkedin_public
  side_event_rsvp
  warm_network
  press_release
  manual_research
}

enum ConferenceIcpCategory {
  executive
  economic_buyer
  operator
  technical_evaluator
  champion
  partner
  other
  unknown
}

enum ConferenceOutreachStatus {
  not_started
  queued
  contacted
  replied
  meeting_requested
  meeting_booked
  nurturing
  disqualified
}

enum ConferenceOptOutStatus {
  unknown
  not_opted_out
  opted_out
}

enum ConferencePriorityBand {
  request_meeting
  personalized_outreach
  nurture
  do_not_prioritize
}

enum ConferenceMeetingStatus {
  not_requested
  requested
  booked
  declined
  completed
  cancelled
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                  User[]
  oidcIdentities         UserOidcIdentity[]
  roles                  Role[]
  accounts               Account[]
  contacts               Contact[]
  leads                  Lead[]
  opportunities          Opportunity[]
  conferences            Conference[]
  conferenceCompanies    ConferenceCompany[]
  conferencePeople       ConferencePerson[]
  conferenceMeetings     ConferenceMeeting[]
  tasks                  Task[]
  notes                  Note[]
  activities             Activity[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  auditLogs              AuditLog[]
  outboxEvents           OutboxEvent[]
  webhookSubscriptions   WebhookSubscription[]
  idempotencyKeys        IdempotencyKey[]

  @@map("tenants")
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  email       String
  displayName String     @map("display_name")
  status      UserStatus @default(invited)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?    @map("created_by") @db.Uuid
  updatedBy   String?    @map("updated_by") @db.Uuid
  version     Int        @default(1)
  archivedAt  DateTime?  @map("archived_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles  UserRole[]
  oidcIdentities UserOidcIdentity[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("users")
}

model UserOidcIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  issuer    String
  subject   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, issuer, subject])
  @@unique([tenantId, userId, issuer])
  @@index([userId])
  @@map("user_oidc_identities")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id           String  @id @default(uuid()) @db.Uuid
  resource     String
  action       String
  conditionKey String? @map("condition_key")

  roles RolePermission[]

  @@unique([resource, action, conditionKey])
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  name         String
  domain       String?
  ownerUserId  String?       @map("owner_user_id") @db.Uuid
  status       AccountStatus @default(prospect)
  customFields Json          @default("{}") @map("custom_fields")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String        @map("created_by") @db.Uuid
  updatedBy    String        @map("updated_by") @db.Uuid
  version      Int           @default(1)
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz(6)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts            Contact[]
  opportunities       Opportunity[]
  conferenceCompanies ConferenceCompany[]
  conferencePeople    ConferencePerson[]

  @@index([tenantId, ownerUserId, status])
  @@index([tenantId, name])
  @@map("accounts")
}

model Contact {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  accountId    String?   @map("account_id") @db.Uuid
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String?
  phone        String?
  ownerUserId  String?   @map("owner_user_id") @db.Uuid
  customFields Json      @default("{}") @map("custom_fields")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String    @map("created_by") @db.Uuid
  updatedBy    String    @map("updated_by") @db.Uuid
  version      Int       @default(1)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account              Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  primaryOpportunities Opportunity[]
  conferencePeople     ConferencePerson[]

  @@index([tenantId, accountId, lastName, firstName])
  @@index([tenantId, email])
  @@map("contacts")
}

model Lead {
  id                     String     @id @default(uuid()) @db.Uuid
  tenantId               String     @map("tenant_id") @db.Uuid
  source                 String
  companyName            String?    @map("company_name")
  contactName            String     @map("contact_name")
  email                  String?
  status                 LeadStatus @default(new)
  convertedAt            DateTime?  @map("converted_at") @db.Timestamptz(6)
  convertedAccountId     String?    @map("converted_account_id") @db.Uuid
  convertedContactId     String?    @map("converted_contact_id") @db.Uuid
  convertedOpportunityId String?    @map("converted_opportunity_id") @db.Uuid
  customFields           Json       @default("{}") @map("custom_fields")
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              String     @map("created_by") @db.Uuid
  updatedBy              String     @map("updated_by") @db.Uuid
  version                Int        @default(1)
  archivedAt             DateTime?  @map("archived_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, source])
  @@index([tenantId, email])
  @@map("leads")
}

model Opportunity {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  accountId         String           @map("account_id") @db.Uuid
  primaryContactId  String?          @map("primary_contact_id") @db.Uuid
  name              String
  stage             OpportunityStage @default(qualification)
  amount            Decimal?         @db.Decimal(18, 2)
  currency          String           @db.Char(3)
  expectedCloseDate DateTime?        @map("expected_close_date") @db.Date
  ownerUserId       String           @map("owner_user_id") @db.Uuid
  probabilityPct    Int?             @map("probability_pct")
  customFields      Json             @default("{}") @map("custom_fields")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String           @map("created_by") @db.Uuid
  updatedBy         String           @map("updated_by") @db.Uuid
  version           Int              @default(1)
  archivedAt        DateTime?        @map("archived_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contact Contact? @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)

  @@index([tenantId, ownerUserId, stage, expectedCloseDate(sort: Desc)])
  @@index([tenantId, accountId])
  @@map("opportunities")
}

model Conference {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  name                 String
  startDate            DateTime             @map("start_date") @db.Date
  endDate              DateTime?            @map("end_date") @db.Date
  location             String?
  website              String?
  audienceType         String?              @map("audience_type")
  organizerContact     String?              @map("organizer_contact")
  sponsorPackageLink   String?              @map("sponsor_package_link")
  appName              String?              @map("app_name")
  attendeeAccessStatus AttendeeAccessStatus @default(unknown) @map("attendee_access_status")
  sourceNotes          String?              @map("source_notes")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy            String               @map("created_by") @db.Uuid
  updatedBy            String               @map("updated_by") @db.Uuid
  version              Int                  @default(1)
  archivedAt           DateTime?            @map("archived_at") @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companies ConferenceCompany[]
  people    ConferencePerson[]
  meetings  ConferenceMeeting[]

  @@index([tenantId, startDate])
  @@index([tenantId, name])
  @@map("conferences")
}

model ConferenceCompany {
  id                      String         @id @default(uuid()) @db.Uuid
  tenantId                String         @map("tenant_id") @db.Uuid
  conferenceId            String         @map("conference_id") @db.Uuid
  accountId               String?        @map("account_id") @db.Uuid
  company                 String
  website                 String?
  conferenceRole          ConferenceRole @default(other) @map("conference_role")
  sector                  String?
  productFit              Boolean        @default(false) @map("product_fit")
  expansionFit            Boolean        @default(false) @map("expansion_fit")
  budgetFit               Boolean        @default(false) @map("budget_fit")
  marketEntryRelevance    Boolean        @default(false) @map("market_entry_relevance")
  partnershipRelevance    Boolean        @default(false) @map("partnership_relevance")
  companyScore            Int            @default(0) @map("company_score")
  sourceUrl               String?        @map("source_url")
  sourceNotes             String?        @map("source_notes")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy               String         @map("created_by") @db.Uuid
  updatedBy               String         @map("updated_by") @db.Uuid
  version                 Int            @default(1)
  archivedAt              DateTime?      @map("archived_at") @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conference Conference         @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  account    Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  people     ConferencePerson[]

  @@index([tenantId, conferenceId, company])
  @@index([tenantId, accountId])
  @@map("conference_companies")
}

model ConferencePerson {
  id                    String                   @id @default(uuid()) @db.Uuid
  tenantId              String                   @map("tenant_id") @db.Uuid
  conferenceId          String                   @map("conference_id") @db.Uuid
  conferenceCompanyId   String?                  @map("conference_company_id") @db.Uuid
  accountId             String?                  @map("account_id") @db.Uuid
  contactId             String?                  @map("contact_id") @db.Uuid
  name                  String
  title                 String
  linkedIn              String?                  @map("linkedin")
  email                 String?
  conferenceSignal      String?                  @map("conference_signal")
  icpCategory           ConferenceIcpCategory    @default(unknown) @map("icp_category")
  buyingSignal          String?                  @map("buying_signal")
  relationshipPath      String?                  @map("relationship_path")
  outreachStatus        ConferenceOutreachStatus @default(not_started) @map("outreach_status")
  sourceType            ConferenceSourceType     @default(manual_research) @map("source_type")
  source                String?
  lawfulBasisNotes      String?                  @map("lawful_basis_notes")
  optOutStatus          ConferenceOptOutStatus   @default(unknown) @map("opt_out_status")
  seniorityScore        Int                      @default(0) @map("seniority_score")
  companyFitScore       Int                      @default(0) @map("company_fit_score")
  signalScore           Int                      @default(0) @map("signal_score")
  conferenceSignalScore Int                      @default(0) @map("conference_signal_score")
  warmIntroScore        Int                      @default(0) @map("warm_intro_score")
  timingScore           Int                      @default(0) @map("timing_score")
  totalScore            Int                      @default(0) @map("total_score")
  priorityBand          ConferencePriorityBand   @default(do_not_prioritize) @map("priority_band")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy             String                   @map("created_by") @db.Uuid
  updatedBy             String                   @map("updated_by") @db.Uuid
  version               Int                      @default(1)
  archivedAt            DateTime?                @map("archived_at") @db.Timestamptz(6)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conference Conference          @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  company    ConferenceCompany?  @relation(fields: [conferenceCompanyId], references: [id], onDelete: SetNull)
  account    Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact    Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  meetings   ConferenceMeeting[]

  @@index([tenantId, conferenceId, priorityBand, totalScore])
  @@index([tenantId, conferenceCompanyId])
  @@index([tenantId, accountId])
  @@index([tenantId, contactId])
  @@map("conference_people")
}

model ConferenceMeeting {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  conferenceId       String                  @map("conference_id") @db.Uuid
  conferencePersonId String                  @map("conference_person_id") @db.Uuid
  reasonToMeet       String                  @map("reason_to_meet")
  proposedAsk        String?                 @map("proposed_ask")
  introPath          String?                 @map("intro_path")
  status             ConferenceMeetingStatus @default(not_requested)
  notes              String?
  nextStep           String?                 @map("next_step")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String                  @map("created_by") @db.Uuid
  updatedBy          String                  @map("updated_by") @db.Uuid
  version            Int                     @default(1)
  archivedAt         DateTime?               @map("archived_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conference Conference       @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  person     ConferencePerson @relation(fields: [conferencePersonId], references: [id], onDelete: Cascade)

  @@index([tenantId, conferenceId, status])
  @@index([tenantId, conferencePersonId])
  @@map("conference_meetings")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  parentType     String?      @map("parent_type")
  parentId       String?      @map("parent_id") @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(open)
  priority       TaskPriority @default(medium)
  dueAt          DateTime?    @map("due_at") @db.Timestamptz(6)
  assignedUserId String       @map("assigned_user_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String       @map("created_by") @db.Uuid
  updatedBy      String       @map("updated_by") @db.Uuid
  version        Int          @default(1)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, assignedUserId, status, dueAt])
  @@index([tenantId, parentType, parentId])
  @@map("tasks")
}

model Note {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  parentType String   @map("parent_type")
  parentId   String   @map("parent_id") @db.Uuid
  body       String
  bodyFormat String   @default("plain_text") @map("body_format")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  String   @map("created_by") @db.Uuid
  updatedBy  String   @map("updated_by") @db.Uuid
  version    Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, parentType, parentId, createdAt(sort: Desc)])
  @@map("notes")
}

model Activity {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  parentType String   @map("parent_type")
  parentId   String   @map("parent_id") @db.Uuid
  kind       String
  subject    String
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  String   @map("created_by") @db.Uuid
  updatedBy  String   @map("updated_by") @db.Uuid
  version    Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, parentType, parentId, occurredAt(sort: Desc)])
  @@map("activities")
}

model CustomFieldDefinition {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  entityType String   @map("entity_type")
  key        String
  label      String
  fieldType  String   @map("field_type")
  required   Boolean  @default(false)
  isIndexed  Boolean  @default(false) @map("is_indexed")
  schema     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  String   @map("created_by") @db.Uuid
  updatedBy  String   @map("updated_by") @db.Uuid
  version    Int      @default(1)

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@unique([tenantId, entityType, key])
  @@index([tenantId, entityType, isIndexed])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  fieldDefinitionId String @map("field_definition_id") @db.Uuid
  entityType        String @map("entity_type")
  entityId          String @map("entity_id") @db.Uuid
  value             Json

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fieldDefinition CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fieldDefinitionId, entityType, entityId])
  @@index([tenantId, entityType, entityId])
  @@map("custom_field_values")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  actorUserId String   @map("actor_user_id") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  before      Json?
  after       Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId, occurredAt(sort: Desc)])
  @@index([tenantId, actorUserId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  type          String
  entityType    String       @map("entity_type")
  entityId      String       @map("entity_id") @db.Uuid
  actorUserId   String       @map("actor_user_id") @db.Uuid
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  payload       Json         @default("{}")
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  nextAttemptAt DateTime?    @map("next_attempt_at") @db.Timestamptz(6)
  deliveredAt   DateTime?    @map("delivered_at") @db.Timestamptz(6)
  lastError     String?      @map("last_error")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, occurredAt])
  @@index([tenantId, entityType, entityId, occurredAt(sort: Desc)])
  @@map("outbox_events")
}

model WebhookSubscription {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  url             String
  secretHash      String    @map("secret_hash")
  secretEncrypted String    @default("") @map("secret_encrypted")
  eventTypes      String[]  @map("event_types")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastErrorAt     DateTime? @map("last_error_at") @db.Timestamptz(6)
  lastError       String?   @map("last_error")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("webhook_subscriptions")
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  route       String
  requestHash String   @map("request_hash")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
