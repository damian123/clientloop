DATABASE_URL="postgresql://clientloop:clientloop@localhost:5432/clientloop?schema=public"
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
SESSION_COOKIE_NAME="clientloop_session"
CSRF_COOKIE_NAME="clientloop_csrf"
SESSION_SIGNING_SECRET="replace-this-with-a-long-random-secret"
SESSION_TTL_SECONDS=28800
ALLOW_HEADER_AUTH=true
ALLOW_DEV_LOGIN=true
# Production OIDC (leave unset for the local dev-login flow):
# OIDC_ISSUER="https://identity.example/"
# OIDC_CLIENT_ID="clientloop"
# OIDC_CLIENT_SECRET="replace-with-provider-secret"
# OIDC_REDIRECT_URI="https://crm.example/v1/session/oidc/callback"
# OIDC_TENANT_ID="00000000-0000-4000-8000-000000000001"
# OIDC_POST_LOGIN_REDIRECT="/"
# OIDC_TRANSACTION_SECRET="replace-with-at-least-32-random-bytes"
# Keep false by default. Enable only during a controlled, temporary migration
# that binds previously unlinked users by a unique verified-email match.
OIDC_ALLOW_EMAIL_LINKING=false
# Webhook signing is a separate trust domain; never reuse an authentication secret.
WEBHOOK_SIGNING_SECRET="replace-me"
WEBHOOK_DELIVERY_BATCH_SIZE=25
CRM_REPOSITORY="prisma"
